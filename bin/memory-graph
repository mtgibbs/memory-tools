#!/usr/bin/env python3
"""
graph.py — traverse the memory graph without reading every file.

An agent reading a note sees what it points AT (the links are in the text) but
cannot see what points AT IT without scanning the whole corpus. Backlinks are
the expensive direction, so that is what this precomputes.

Everything is derived from the markdown at call time — there is no index to
rebuild, nothing to keep in sync, and no daemon. At this corpus size a full
parse is a few milliseconds.

Links are reported with provenance: `authored` links are hand-written,
`inferred` ones come from the block infer-links.py maintains. Weight them
accordingly — an inferred link is a suggestion, not an assertion.

  graph.py neighbors <note> [--hops N]   what connects to this, both directions
  graph.py path <from> <to>              how two notes are related, if at all
  graph.py keystones [-n N]              most-linked-to notes
  graph.py orphans                       notes nothing reaches
  graph.py challenged                    claims marked doubted but not yet resolved
  graph.py realms                        per-realm connectivity summary
  graph.py canvas [--out FILE]           realm zones as an Obsidian .canvas file
  graph.py forcemap [--out FILE]         force-directed map with realm forcefields (HTML)
  graph.py spheregrid [--center R]       assigned-position atlas, galaxies + rings (HTML)

Add --json to any subcommand for machine-readable output.
"""

from __future__ import annotations
import argparse, json, math, os, re, sys
from collections import defaultdict, deque
from pathlib import Path

BEGIN = "<!-- inferred-links:begin -->"
END = "<!-- inferred-links:end -->"
INVALID = re.compile(r"^\s*status:\s*(superseded|expired)\b", re.M | re.I)
WIKI = re.compile(r"\[\[([^\]|#]+)")
SCORED = re.compile(r"\[\[([^\]|#]+)\]\][^\n]*?—\s*(0\.\d+)")
MD = re.compile(r"\[[^\]]*\]\(([^)\s]+\.md)\)")
CHALLENGE = re.compile(r"^\*\*CHALLENGED\s+(\d{4}-\d{2}-\d{2})\s*:?\s*\*\*:?\s*(.*)$", re.I)


def body_of(text: str) -> str:
    """Everything after the YAML frontmatter."""
    lines = text.splitlines(keepends=True)
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                return "".join(lines[i + 1:])
    return text


def parse_challenges(body: str) -> list[dict]:
    """Find every `**CHALLENGED <date>:** why` marker and the claim it challenges.

    Status in frontmatter is per NOTE; doubt arrives per CLAIM. A 240-line note
    with one wrong sentence cannot say so — which is why several notes already
    carry hand-improvised `(SUPERSEDED)` and `CLOSED <date>:` markers in prose.
    This is that habit, standardised so the tools can read it.

    The marker is APPENDED below the claim, never written over it: an unresolved
    doubt must not erase the thing being doubted. It scopes to the paragraph
    directly above; placed at the top of the body, it scopes to the whole note.
    Deleting the marker is how a challenge resolves in the claim's favour — git
    log keeps the record either way."""
    lines = body.splitlines()
    out, i = [], 0
    while i < len(lines):
        m = CHALLENGE.match(lines[i].strip())
        if not m:
            i += 1
            continue
        why, j = [m.group(2).strip()], i + 1
        while j < len(lines) and lines[j].strip() and not CHALLENGE.match(lines[j].strip()):
            why.append(lines[j].strip())
            j += 1
        end = i - 1
        while end >= 0 and not lines[end].strip():
            end -= 1
        start = end
        while start >= 0 and lines[start].strip() \
                and not lines[start].lstrip().startswith("#") \
                and not CHALLENGE.match(lines[start].strip()):
            start -= 1
        claim = [l.strip() for l in lines[start + 1:end + 1] if l.strip()]
        out.append({"date": m.group(1), "why": " ".join(w for w in why if w),
                    "claim": " ".join(claim), "lines": claim,
                    "marker": [l.strip() for l in lines[i:j] if l.strip()]})
        i = j
    return out


class Graph:
    def __init__(self, vault: Path):
        self.vault = vault
        self.realm: dict[str, str] = {}
        self.out: dict[str, list[tuple[str, str]]] = defaultdict(list)
        self.inn: dict[str, list[tuple[str, str]]] = defaultdict(list)
        self._load()

    def _load(self) -> None:
        # Nodes are keyed "<realm>/<stem>", NOT by basename. Thirteen realms each
        # hold a MEMORY.md; collapsing them into one node invents a 2-hop path
        # between every pair of realms through a file that does not exist.
        # Obsidian keeps them as distinct nodes too — only link *resolution* is
        # ambiguous there, which is what by_stem below models.
        paths = sorted(self.vault.glob("*/memory/*.md"))
        self.by_stem: dict[str, list[str]] = defaultdict(list)
        for p in paths:
            node = f"{p.parts[-3]}/{p.stem}"
            self.realm[node] = p.parts[-3]
            self.by_stem[p.stem].append(node)
        self.status: dict[str, str] = {}
        self.challenged: dict[str, list[dict]] = {}
        for p in paths:
            src = f"{p.parts[-3]}/{p.stem}"
            text = p.read_text(encoding="utf-8", errors="replace")
            sm = INVALID.search(text[:600])
            if sm:
                self.status[src] = sm.group(1).lower()
            ch = parse_challenges(body_of(text))
            if ch:
                self.challenged[src] = ch
            authored, inferred = text, ""
            if BEGIN in text:
                authored, _, rest = text.partition(BEGIN)
                inferred, _, tail = rest.partition(END)
                authored += tail
            self.score = getattr(self, "score", {})
            for m in SCORED.finditer(inferred):
                self.score[(src, m.group(1).strip())] = float(m.group(2))
            for chunk, prov in ((authored, "authored"), (inferred, "inferred")):
                for raw in WIKI.findall(chunk):
                    self._edge(src, raw.strip(), prov)
                for raw in MD.findall(chunk):
                    self._edge(src, Path(raw).stem, prov)

    def _target(self, src: str, stem: str) -> str | None:
        """Resolve a link the way Obsidian does: a note in the linker's own realm
        wins; otherwise a unique vault-wide match. Ambiguous links resolve to
        nothing rather than to an arbitrary pick."""
        cands = self.by_stem.get(stem, [])
        same = [c for c in cands if self.realm[c] == self.realm.get(src)]
        if same:
            return same[0]
        return cands[0] if len(cands) == 1 else None

    def _edge(self, src: str, stem: str, prov: str) -> None:
        dst = self._target(src, stem)
        if dst is None:                       # ghost, or ambiguous across realms
            if (stem, prov) not in self.out[src]:
                self.out[src].append((stem, prov))
            return
        if dst == src:
            return
        if (dst, prov) not in self.out[src]:
            self.out[src].append((dst, prov))
        if (src, prov) not in self.inn[dst]:
            self.inn[dst].append((src, prov))

    def exists(self, name: str) -> bool:
        return name in self.realm

    def resolve(self, name: str) -> str | None:
        if name in self.realm:
            return name
        exact = self.by_stem.get(name, [])
        if len(exact) == 1:
            return exact[0]
        hits = exact or [n for n in self.realm if name.lower() in n.split("/")[-1].lower()]
        if len(hits) == 1:
            return hits[0]
        if hits:
            print(f"ambiguous: {name!r} matches {len(hits)}", file=sys.stderr)
            for h in sorted(hits)[:8]:
                print(f"  {h}", file=sys.stderr)
        return None

    def undirected(self, node: str) -> set[str]:
        return {d for d, _ in self.out[node] if d in self.realm} | {s for s, _ in self.inn[node]}


def cmd_neighbors(g: Graph, a) -> dict:
    node = g.resolve(a.note)
    if not node:
        print(f"no note matching {a.note!r}", file=sys.stderr)
        sys.exit(1)
    out = {"note": node, "realm": g.realm[node], "hops": {},
           "status": g.status.get(node)}
    seen, frontier = {node}, {node}
    for hop in range(1, a.hops + 1):
        nxt = set()
        for n in frontier:
            nxt |= g.undirected(n)
        nxt -= seen
        seen |= nxt
        out["hops"][hop] = sorted(nxt)
        frontier = nxt
    stem = node.split("/")[-1]
    def sc(a, b):
        return g.score.get((a, b.split("/")[-1]))
    out["outbound"] = [{"to": d, "provenance": p, "resolves": d in g.realm,
                        "score": sc(node, d)} for d, p in g.out[node]]
    out["inbound"] = [{"from": s, "provenance": p, "score": sc(s, node)} for s, p in g.inn[node]]
    return out


def cmd_path(g: Graph, a) -> dict:
    s, t = g.resolve(a.frm), g.resolve(a.to)
    if not s or not t:
        print("could not resolve both endpoints", file=sys.stderr)
        sys.exit(1)
    prev, q = {s: None}, deque([s])
    while q:
        cur = q.popleft()
        if cur == t:
            break
        for nb in sorted(g.undirected(cur)):
            if nb not in prev:
                prev[nb] = cur
                q.append(nb)
    if t not in prev:
        return {"from": s, "to": t, "path": None, "note": "no path — these are in disconnected components"}
    path, cur = [], t
    while cur is not None:
        path.append(cur)
        cur = prev[cur]
    return {"from": s, "to": t, "hops": len(path) - 1, "path": list(reversed(path))}


def cmd_keystones(g: Graph, a) -> dict:
    """Ranked by AUTHORED inbound links only.

    An inferred link is vocabulary overlap, not a human saying "this matters" —
    counting it toward centrality lets repetition masquerade as corroboration
    (the failure the Jim Carrey knowledge-panel essay names). Ranking by the sum
    put level5-north-star-plan at #2 on 22 inbound of which 15 were machine echo.
    Inferred counts still print, as a separate, clearly-labelled column;
    --include-inferred restores the old ranking for anyone who wants it."""
    rows = []
    for n in g.realm:
        auth = sum(1 for _, p in g.inn[n] if p == "authored")
        infr = sum(1 for _, p in g.inn[n] if p == "inferred")
        if auth + infr:
            rows.append({"note": n.split("/")[-1], "realm": g.realm[n], "inbound": auth + infr,
                         "authored": auth, "inferred": infr})
    key = (lambda r: (-r["inbound"], -r["authored"], r["note"])) if a.include_inferred \
        else (lambda r: (-r["authored"], -r["inferred"], r["note"]))
    rows.sort(key=key)
    if not a.include_inferred:
        rows = [r for r in rows if r["authored"]]
    return {"keystones": rows[: a.n], "ranked_by": "inbound" if a.include_inferred else "authored"}


def cmd_stale_refs(g: Graph, a) -> dict:
    """Live notes still pointing at invalidated ones — where a correction has not
    yet travelled. `brief` refuses to quote these at read time, but the link is
    still sitting in the file; an authored one needs a human, an inferred one is
    cleared by re-running memory-infer --write."""
    rows = []
    for src in sorted(g.realm):
        if src in g.status:
            continue                       # history citing history is fine
        for dst, prov in g.out[src]:
            if dst in g.realm and dst in g.status:
                rows.append({"note": src.split("/")[-1], "realm": g.realm[src],
                             "points_at": dst.split("/")[-1], "state": g.status[dst],
                             "provenance": prov})
    return {"stale_refs": rows, "count": len(rows),
            "authored": sum(1 for r in rows if r["provenance"] == "authored")}


def cmd_challenged(g: Graph, a) -> dict:
    """Claims currently marked doubted — the state between live and invalidated.

    `expired`/`superseded` is a verdict; a challenge is an open question, and
    collapsing the two in either direction loses the thing worth keeping. These
    stay in their files and stay readable; what they lose is the right to be
    quoted as fact by `brief`."""
    rows = []
    for node in sorted(g.challenged):
        for c in g.challenged[node]:
            rows.append({"note": node.split("/")[-1], "realm": g.realm[node],
                         "date": c["date"], "why": c["why"], "claim": c["claim"],
                         "scope": "note" if not c["lines"] else "claim",
                         "note_status": g.status.get(node)})
    rows.sort(key=lambda r: (r["date"], r["realm"], r["note"]))
    return {"challenged": rows, "count": len(rows), "notes": len({r["note"] for r in rows})}


def cmd_orphans(g: Graph, a) -> dict:
    o = [{"note": n.split("/")[-1], "realm": g.realm[n]} for n in sorted(g.realm)
         if not g.out[n] and not g.inn[n]]
    return {"orphans": o, "count": len(o), "total": len(g.realm)}


def cmd_realms(g: Graph, a) -> dict:
    agg = defaultdict(lambda: {"notes": 0, "intra": 0, "cross": 0, "dangling": 0})
    for n, r in g.realm.items():
        agg[r]["notes"] += 1
        for d, _ in g.out[n]:
            if d not in g.realm:
                agg[r]["dangling"] += 1
            elif g.realm[d] == r:
                agg[r]["intra"] += 1
            else:
                agg[r]["cross"] += 1
    return {"realms": [{"realm": k, **v} for k, v in sorted(agg.items(), key=lambda kv: -kv[1]["notes"])]}


def cmd_brief(g: Graph, a) -> dict:
    """A §6-ready block: the map's most relevant notes for a spec being written.
    This is how loops read the map — at authoring time, pushed into the spec,
    never pulled at run time. Invalidated notes are excluded: history must not
    brief new work.

    Exclusion travels downstream too: a quoted line that points at an invalidated
    note is not quoted, and invalidated neighbours are dropped from the links
    list. A correction has to reach everything that repeats the claim, not just
    the note that carried it — otherwise a retracted fact keeps briefing new work
    through its citations. Anything dropped is reported, never silently removed."""
    terms = [t.lower() for t in a.terms]
    scored = []
    for node, realm in g.realm.items():
        if node in g.status or node.split("/")[-1] == "MEMORY":
            continue
        path = g.vault / realm / "memory" / (node.split("/")[-1] + ".md")
        try:
            raw = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        desc = ""
        dm = re.search(r'^description:\s*["\']?(.+?)["\']?$', raw[:600], re.M)
        if dm:
            desc = dm.group(1)
        low = raw.lower()
        score = sum(3 * desc.lower().count(t) + low.count(t) for t in terms)
        if score == 0:
            continue
        def stale_refs(text: str) -> list[str]:
            """Invalidated notes this text cites — a retracted claim must not ride
            back in as a quotation."""
            out = []
            for raw_link in WIKI.findall(text):
                tgt = g._target(node, raw_link.strip())
                if tgt and tgt in g.status:
                    out.append(f"{tgt.split('/')[-1]} ({g.status[tgt]})")
            return out

        body = body_of(raw)
        chal = parse_challenges(body)
        withheld = {l for c in chal for l in c["lines"] + c["marker"]}
        note_wide = any(not c["lines"] for c in chal)
        best, suppressed = "", []
        for line in body.splitlines():     # body only: frontmatter is not a fact line
            ll = line.lower()
            n = sum(ll.count(t) for t in terms)
            skip = line.startswith(("---", "description:")) or line.strip().startswith("[[")
            if n > 0 and len(line.strip()) > 20 and not skip:
                if note_wide or line.strip() in withheld:
                    continue                   # doubted — reported below, not quoted
                bad = stale_refs(line)
                if bad:
                    suppressed.extend(bad)
                    continue
                if not best or n > sum(best.lower().count(t) for t in terms):
                    best = line.strip().lstrip("-*# ").strip()
        neighbors, dropped = [], []
        for d, prov in g.out[node]:
            if prov != "authored" or d not in g.realm:
                continue
            if d in g.status:
                dropped.append(f"{d.split('/')[-1]} ({g.status[d]})")
            elif len(neighbors) < 3:
                neighbors.append(d.split("/")[-1])
        scored.append({"note": node.split("/")[-1], "realm": realm, "score": score,
                       "description": desc, "line": best[:160], "authored_links": neighbors,
                       "excluded_stale": sorted(set(suppressed + dropped)),
                       "challenged": [{"date": c["date"], "why": c["why"],
                                       "scope": "note" if not c["lines"] else "claim"}
                                      for c in chal]})
    scored.sort(key=lambda r: -r["score"])
    return {"query": " ".join(a.terms), "briefs": scored[: a.n]}


def cmd_canvas(g: Graph, a) -> dict:
    """Realm zones as a generated Obsidian Canvas — the layout the force-directed
    graph view cannot hold: one labeled group box per realm, personal realms on
    the left, work-- realms on the right, an empty corridor between the sides.
    Only cross-realm edges are drawn (the zone box already says "these belong
    together"); edges that cross the personal/work boundary are purple. A canvas
    is a snapshot, not live physics — regenerate after the vault changes."""
    NODE_W, NODE_H, PAD, COLS = 260, 50, 20, 3
    REALM_GAP, SIDE_GAP, COL_GAP = 80, 1800, 60

    def is_work(realm: str) -> bool:
        return realm.startswith("work--")

    def short(slug: str) -> str:
        s = slug.removeprefix("work--").removeprefix("-Users-mtgibbs-")
        return s or slug

    by_realm: dict[str, list[str]] = defaultdict(list)
    for node, realm in g.realm.items():
        if node.split("/")[-1] != "MEMORY":
            by_realm[realm].append(node)

    pairs: dict[frozenset, tuple[str, str, bool]] = {}
    for src in g.realm:
        if src.split("/")[-1] == "MEMORY":
            continue
        for dst, _ in g.out[src]:
            if dst not in g.realm or dst.split("/")[-1] == "MEMORY":
                continue
            if g.realm[dst] == g.realm[src]:
                continue
            pairs.setdefault(frozenset([src, dst]),
                             (src, dst, is_work(g.realm[src]) != is_work(g.realm[dst])))

    def box(n_notes: int) -> tuple[int, int]:
        rows = (n_notes + COLS - 1) // COLS
        return (COLS * NODE_W + (COLS + 1) * PAD,
                rows * (NODE_H + PAD) + PAD + 40)

    nodes: list[dict] = []
    placed: set[str] = set()
    for work in (False, True):
        realm_list = sorted((r for r in by_realm if is_work(r) == work),
                            key=lambda r: -len(by_realm[r]))
        base = 0 if not work else box(1)[0] * 2 + COL_GAP + SIDE_GAP
        col_x = [base, base + box(1)[0] + COL_GAP]
        col_y = [0, 0]
        for realm in realm_list:
            names = sorted(by_realm[realm])
            w, h = box(len(names))
            c = 0 if col_y[0] <= col_y[1] else 1
            gx, gy = col_x[c], col_y[c]
            col_y[c] += h + REALM_GAP
            nodes.append({"id": f"g-{realm}", "type": "group", "x": gx, "y": gy,
                          "width": w, "height": h, "label": short(realm),
                          **({"color": "1"} if work else {})})
            for i, node in enumerate(names):
                stem = node.split("/")[-1]
                nodes.append({"id": node, "type": "file",
                              "x": gx + PAD + (i % COLS) * (NODE_W + PAD),
                              "y": gy + 40 + PAD + (i // COLS) * (NODE_H + PAD),
                              "width": NODE_W, "height": NODE_H,
                              "file": f"{realm}/memory/{stem}.md"})
                placed.add(node)

    edges: list[dict] = []
    n_boundary = 0
    for i, (src, dst, boundary) in enumerate(pairs.values()):
        if src not in placed or dst not in placed:
            continue
        e: dict = {"id": f"e{i}", "fromNode": src, "toNode": dst}
        if boundary:
            n_boundary += 1
            e["color"] = "6"
            e["fromSide"] = "left" if is_work(g.realm[src]) else "right"
            e["toSide"] = "left" if is_work(g.realm[dst]) else "right"
        edges.append(e)

    out = Path(a.out).expanduser() if a.out else g.vault / "atlas.canvas"
    out.write_text(json.dumps({"nodes": nodes, "edges": edges}))
    return {"canvas": str(out),
            "notes": len(placed),
            "zones": sum(1 for n in nodes if n["type"] == "group"),
            "cross_realm_edges": len(edges),
            "boundary_edges": n_boundary}


TYPE_RE = re.compile(r"^\s*type:\s*(user|feedback)\b", re.M | re.I)


def cmd_forcemap(g: Graph, a) -> dict:
    """The force graph with forcefields: a self-contained HTML page (Canvas 2D,
    no dependencies, harness-console lineage). Real physics — springs, repulsion —
    but every node is also pulled toward its realm's anchor, so realms hold
    together as visible fields: personal wells left, work-- wells right, the
    corridor between them kept empty by design (boundary springs are weak on
    purpose). Data is embedded at generation time; regenerate when the vault
    moves. Clicking a node opens it in Obsidian via the obsidian:// URI."""
    def short(slug: str) -> str:
        s = slug.removeprefix("work--").removeprefix("-Users-mtgibbs-")
        return s or slug

    nodes, index = [], {}
    for node, realm in sorted(g.realm.items()):
        stem = node.split("/")[-1]
        if stem == "MEMORY":
            continue
        path = g.vault / realm / "memory" / (stem + ".md")
        try:
            head = path.read_text(encoding="utf-8", errors="replace")[:600]
        except OSError:
            head = ""
        index[node] = len(nodes)
        nodes.append({"stem": stem, "realm": realm, "short": short(realm),
                      "work": realm.startswith("work--"),
                      "gold": bool(TYPE_RE.search(head)),
                      "dead": node in g.status,
                      "deg": len(g.inn[node])})

    pairs: dict[frozenset, dict] = {}
    for src in index:
        for dst, _ in g.out[src]:
            if dst not in index or dst == src:
                continue
            same = g.realm[src] == g.realm[dst]
            boundary = nodes[index[src]]["work"] != nodes[index[dst]]["work"]
            pairs.setdefault(frozenset([src, dst]),
                             {"s": index[src], "t": index[dst],
                              "i": int(same), "b": int(boundary)})
    edges = list(pairs.values())

    data = json.dumps({"vault": g.vault.name, "root": str(g.vault),
                       "nodes": nodes, "edges": edges}).replace("</", "<\\/")
    tpl_path = Path(__file__).resolve().parent.parent / "templates" / "forcemap.html"
    tpl = tpl_path.read_text(encoding="utf-8")
    assert tpl.count("__DATA__") == 1, f"placeholder missing in {tpl_path}"
    out = Path(a.out).expanduser() if a.out else g.vault / "atlas.html"
    out.write_text(tpl.replace("__DATA__", data))
    return {"forcemap": str(out), "notes": len(nodes), "edges": len(edges),
            "boundary_edges": sum(e["b"] for e in edges),
            "identity_notes": sum(1 for n in nodes if n["gold"])}


def _realm_slug_for_cwd() -> str:
    """The vault folder name Claude Code derives from a working directory:
    the absolute path with every separator turned into a dash. This is the hook
    that lets a session ask "which galaxy am I in?" without being told."""
    return str(Path.cwd().resolve()).replace(os.sep, "-")


def _anchor_of(g: Graph, members: list[str]) -> str:
    """The note a realm is actually about — most AUTHORED inbound links from
    inside its own realm. Authored-only for the same reason cmd_keystones ranks
    that way: a machine-guessed link is vocabulary overlap, not endorsement, and
    letting it pick the centre would put whichever note shares the most jargon
    at the heart of the map. Ties break on total degree, then name, so the
    anchor never moves between runs on a corpus that has not changed."""
    def rank(n: str) -> tuple:
        auth = sum(1 for s, p in g.inn[n] if p == "authored" and g.realm.get(s) == g.realm[n])
        return (-auth, -len(g.undirected(n)), n)
    return min(members, key=rank)


def _hops_from(g: Graph, start: str, within: set[str]) -> dict[str, int]:
    """BFS confined to one realm. Radius on the finished map means this number,
    so it must not be able to leak out of the realm and come back — a two-hop
    detour through another galaxy is not what 'close to the centre' should mean."""
    hop = {start: 0}
    q = deque([start])
    while q:
        cur = q.popleft()
        for nxt in g.undirected(cur):
            if nxt in within and nxt not in hop:
                hop[nxt] = hop[cur] + 1
                q.append(nxt)
    return hop


def cmd_spheregrid(g: Graph, a) -> dict:
    """The sphere-grid atlas: assigned positions, drawn links, no layout physics.

    A force graph makes every edge a force, so a note that reaches into five
    realms gets dragged to the barycentre and the realm structure smears. The
    forcemap fights that with three separate corrections (crippled boundary
    springs, a per-realm field, a pre-pass that packs anchors before physics
    starts) — three attempts to make a simulation stop simulating. Here position
    is computed once and kept: angle is which realm, radius is how many hops
    from that realm's anchor. Both become quantities you can read, and the map
    is byte-identical on every run over an unchanged corpus, so a place on it
    can be pointed at twice.

    Motion survives as animation only — the template springs each node toward
    the slot computed here. Dragging displaces a node; letting go returns it.

    Layout is two nested problems. Inside a realm, notes sit on concentric rings
    by hop distance from the anchor (RUBRIC's memory disc). Realms themselves are
    discs placed on the plane by corridor distance from --center, so zoomed out
    the map reads as a graph of galaxies and zoomed in each one resolves into its
    own grid."""
    RING0, ROW_GAP, HOP_GAP, MIN_ARC = 44.0, 17.0, 30.0, 26.0
    GA = 2.399963229728653          # golden angle, same constant the forcemap uses

    def short(slug: str) -> str:
        s = slug.removeprefix("work--").removeprefix("-Users-mtgibbs-")
        return s or slug

    # Hashed into a curated set, not across the whole wheel. A free hash gives you
    # red next to lime next to cyan and the map reads as noise; these ten hues
    # share a register so realm colour stays an identifier instead of competing
    # for attention. 22-26 is left out on purpose — the accent belongs to
    # whichever realm is the centre, and a second orange galaxy reads as home.
    PALETTE = (265, 315, 205, 174, 48, 288, 194, 338, 158, 226)

    def hue_map(names: list[str]) -> dict[str, int]:
        """Hash for the preference, probe for the collision.

        Straight `PALETTE[h % 10]` over fifteen realms is a guaranteed clash —
        pi-cluster, mtgibbs-xyz and font-color all landed on 288, which makes
        colour useless exactly where the map is busiest. Probing walks to the
        next free slot, then to shifted variants, so every realm gets its own.
        Assignment runs in name order, so it is the same on every run over the
        same set of realms."""
        taken: set[int] = set()
        out: dict[str, int] = {}
        for name in sorted(names):
            h = 0
            for ch in name:
                h = (h * 31 + ord(ch)) & 0xFFFFFFFF
            start = h % len(PALETTE)
            for step in range(len(PALETTE) * 3):
                base = PALETTE[(start + step) % len(PALETTE)]
                hue = (base + (step // len(PALETTE)) * 13) % 360
                if hue not in taken:
                    break
            taken.add(hue)
            out[name] = hue
        return out

    # ---- membership ------------------------------------------------------
    by_realm: dict[str, list[str]] = defaultdict(list)
    for node, realm in g.realm.items():
        if node.split("/")[-1] != "MEMORY":
            by_realm[realm].append(node)
    by_realm = {r: sorted(m) for r, m in by_realm.items() if m}
    hues = hue_map(list(by_realm))

    # ---- which galaxy is the centre --------------------------------------
    want = a.center
    if want in (None, "auto"):
        slug = _realm_slug_for_cwd()
        want = slug if slug in by_realm else None
        # a realm that exists but holds only its MEMORY.md is not "not a realm" —
        # it is a project that has not written anything down yet, and saying so
        # is the difference between a bug report and a nudge
        centre_from = "cwd" if want else (
            "empty" if (g.vault / slug).is_dir() else "largest")
    else:
        centre_from = "flag"
    if want not in by_realm:
        hits = [r for r in by_realm if want and want in r]
        want = hits[0] if len(hits) == 1 else max(by_realm, key=lambda r: len(by_realm[r]))
    centre_realm = want

    # ---- realm adjacency, for corridor distance --------------------------
    corridors: dict[frozenset, dict] = {}
    radj: dict[str, set[str]] = defaultdict(set)
    for src in g.realm:
        if src.split("/")[-1] == "MEMORY":
            continue
        for dst, prov in g.out[src]:
            if dst not in g.realm or dst.split("/")[-1] == "MEMORY":
                continue
            ra, rb = g.realm[src], g.realm[dst]
            if ra == rb:
                continue
            radj[ra].add(rb)
            radj[rb].add(ra)
            k = frozenset([ra, rb])
            e = corridors.setdefault(k, {"a": ra, "b": rb, "n": 0, "auth": 0})
            e["n"] += 1
            e["auth"] += int(prov == "authored")

    dist = {centre_realm: 0}
    q = deque([centre_realm])
    while q:
        cur = q.popleft()
        for nxt in sorted(radj[cur]):
            if nxt in by_realm and nxt not in dist:
                dist[nxt] = dist[cur] + 1
                q.append(nxt)
    far = max(dist.values(), default=0) + 1
    for r in by_realm:
        dist.setdefault(r, far)          # nothing links to it — park it at the rim

    # ---- per-realm sphere grid -------------------------------------------
    # Positions are realm-local here; the global offset is added once the discs
    # are placed, so a realm's interior never changes when the map re-centres.
    pos: dict[str, tuple[float, float]] = {}
    hop_of: dict[str, int] = {}
    realms_out: list[dict] = []
    for realm, members in sorted(by_realm.items()):
        mset = set(members)
        anchor = _anchor_of(g, members)
        hop = _hops_from(g, anchor, mset)
        rim = max(hop.values(), default=0) + 1
        for m in members:
            hop.setdefault(m, rim)       # unreachable inside its own realm: the outer rim
        rings: dict[int, list[str]] = defaultdict(list)
        for m in members:
            hop_of[m] = hop[m]
            rings[hop[m]].append(m)
        # A hop band is not one circle. pi-cluster puts 40 of its 59 notes one hop
        # from its anchor — as a single ring that is an unreadable necklace, and
        # radius stops carrying information because almost every node shares it.
        # So a band spills into concentric ARC ROWS the way RUBRIC's memory disc
        # does, most-connected on the inside row, and the gap between bands stays
        # wider than the gap between rows so a hop boundary is still visible.
        hop_r: list[float] = []
        cur = 0.0
        max_r = 0.0
        for h in sorted(rings):
            ms = sorted(rings[h], key=lambda m: (-len(g.undirected(m)), m))
            if h == 0 and len(ms) == 1:
                pos[ms[0]] = (0.0, 0.0)
                cur = RING0
                hop_r.append(0.0)
                continue
            cur = max(cur, RING0)
            hop_r.append(round(cur, 1))
            row = 0
            while ms:
                rad = cur + row * ROW_GAP
                cap = max(6, int(2 * math.pi * rad / MIN_ARC))
                take, ms = ms[:cap], ms[cap:]
                off = GA * (h + row)     # stagger rows so nodes never line up radially
                for j, m in enumerate(take):
                    th = 2 * math.pi * j / len(take) + off
                    pos[m] = (rad * math.cos(th), rad * math.sin(th))
                max_r = max(max_r, rad)
                row += 1
            cur = cur + max(1, row - 1) * ROW_GAP + HOP_GAP
        realms_out.append({"name": realm, "short": short(realm),
                           "work": realm.startswith("work--"),
                           "n": len(members), "anchor": anchor.split("/")[-1],
                           "hue": hues[realm], "rad": max_r + 22, "hopR": hop_r,
                           "dist": dist[realm], "rings": max(rings) if rings else 0,
                           "centre": realm == centre_realm,
                           "minor": len(members) < a.min_galaxy})

    # ---- place the discs --------------------------------------------------
    # Ring per corridor-distance; within a ring, angle is shared out in
    # proportion to disc size so a 60-note galaxy is not given the same slice as
    # a 2-note one. Then a relaxation pass separates any pair still overlapping.
    by_dist: dict[int, list[dict]] = defaultdict(list)
    for r in realms_out:
        by_dist[r["dist"]].append(r)
    ring_r = 0.0
    for d in sorted(by_dist):
        band = sorted(by_dist[d], key=lambda r: (-r["n"], r["name"]))
        if d == 0:
            for r in band:
                r["x"] = r["y"] = 0.0
            ring_r = max(r["rad"] for r in band) if band else 0.0
            continue
        widest = max(r["rad"] for r in band)
        # LABEL_ROOM is why the ring is bigger than geometry alone needs: a realm
        # name is ~150px of text hanging off a disc that may only be 22 across,
        # and a band packed to touching discs collides every label in it.
        LABEL_ROOM = 150.0
        need = sum(2 * r["rad"] + LABEL_ROOM for r in band) / (2 * math.pi)
        ring_r = max(ring_r + widest * 2.2 + 150, need)
        span = sum(2 * r["rad"] + LABEL_ROOM for r in band)
        acc = 0.0
        for r in band:
            acc += r["rad"] + LABEL_ROOM / 2
            th = 2 * math.pi * acc / span + GA * d
            r["x"] = ring_r * math.cos(th)
            r["y"] = ring_r * math.sin(th)
            acc += r["rad"] + LABEL_ROOM / 2
    for _ in range(400):                 # separate overlaps without moving the centre
        for i in range(len(realms_out)):
            for j in range(i + 1, len(realms_out)):
                A, B = realms_out[i], realms_out[j]
                dx, dy = B["x"] - A["x"], B["y"] - A["y"]
                d = math.hypot(dx, dy) or 0.01
                want_d = A["rad"] + B["rad"] + 90
                if d < want_d:
                    f = (want_d - d) / d * 0.25
                    if A["dist"]:
                        A["x"] -= dx * f; A["y"] -= dy * f
                    if B["dist"]:
                        B["x"] += dx * f; B["y"] += dy * f

    origin = {r["name"]: (r["x"], r["y"]) for r in realms_out}

    # ---- nodes ------------------------------------------------------------
    nodes, index = [], {}
    for realm, members in sorted(by_realm.items()):
        ox, oy = origin[realm]
        for node in members:
            stem = node.split("/")[-1]
            path = g.vault / realm / "memory" / (stem + ".md")
            try:
                head = path.read_text(encoding="utf-8", errors="replace")[:600]
            except OSError:
                head = ""
            lx, ly = pos[node]
            index[node] = len(nodes)
            nodes.append({"stem": stem, "realm": realm, "short": short(realm),
                          "work": realm.startswith("work--"),
                          "gold": bool(TYPE_RE.search(head)),
                          "dead": node in g.status,
                          "chal": len(g.challenged.get(node, [])),
                          "hop": hop_of[node],
                          "deg": sum(1 for _, p in g.inn[node] if p == "authored"),
                          "conn": len(g.undirected(node)),
                          "x": round(ox + lx, 2), "y": round(oy + ly, 2)})

    # ---- edges ------------------------------------------------------------
    # A pair linked both by hand and by the inference pass counts as authored:
    # the machine agreeing with you does not downgrade what you wrote.
    pairs: dict[frozenset, dict] = {}
    for src in index:
        for dst, prov in g.out[src]:
            if dst not in index or dst == src:
                continue
            k = frozenset([src, dst])
            e = pairs.get(k)
            if e is None:
                e = pairs[k] = {"s": index[src], "t": index[dst],
                                "i": int(g.realm[src] == g.realm[dst]),
                                "b": int(nodes[index[src]]["work"] != nodes[index[dst]]["work"]),
                                "g": 1}
            if prov == "authored":
                e["g"] = 0
    edges = list(pairs.values())

    data = json.dumps({"vault": g.vault.name, "root": str(g.vault),
                       "centre": centre_realm, "centre_short": short(centre_realm),
                       "centre_from": centre_from,
                       "nodes": nodes, "edges": edges, "realms": realms_out,
                       "corridors": [c for c in corridors.values()
                                     if c["a"] in origin and c["b"] in origin]},
                      separators=(",", ":")).replace("</", "<\\/")
    tpl_path = Path(__file__).resolve().parent.parent / "templates" / "spheregrid.html"
    tpl = tpl_path.read_text(encoding="utf-8")
    assert tpl.count("__DATA__") == 1, f"placeholder missing in {tpl_path}"
    out = Path(a.out).expanduser() if a.out else g.vault / "spheregrid.html"
    out.write_text(tpl.replace("__DATA__", data))
    return {"spheregrid": str(out), "notes": len(nodes), "edges": len(edges),
            "ghost_edges": sum(e["g"] for e in edges),
            "galaxies": sum(1 for r in realms_out if not r["minor"]),
            "minor": sum(1 for r in realms_out if r["minor"]),
            "corridors": len(corridors), "centre": short(centre_realm),
            "centre_from": centre_from,
            "rings": max((r["rings"] for r in realms_out), default=0)}


def render(cmd: str, data: dict) -> None:
    if cmd == "neighbors":
        flag = data.get("status")
        print(f"{data['note']}   [{data['realm']}]" + (f"   ⚠ {flag.upper()} — history, not current" if flag else ""))
        print(f"\n  outbound ({len(data['outbound'])}):")
        for e in data["outbound"]:
            flag = "" if e["resolves"] else "  ← GHOST, target does not exist"
            w = f" ({e['score']:.2f})" if e.get("score") else ""
            print(f"    {e['provenance']:<9}{w:<7} -> {e['to']}{flag}")
        print(f"\n  inbound ({len(data['inbound'])}):")
        for e in data["inbound"]:
            w = f" ({e['score']:.2f})" if e.get("score") else ""
            print(f"    {e['provenance']:<9}{w:<7} <- {e['from']}")
        for hop, names in data["hops"].items():
            if int(hop) > 1 and names:
                print(f"\n  {hop} hops away ({len(names)}): {', '.join(names[:12])}"
                      + (" …" if len(names) > 12 else ""))
    elif cmd == "brief":
        print(f"<!-- memory-brief · query: {data['query']} · point-in-time, verify before trusting -->")
        print("**Prior knowledge from the memory map:**\n")
        for b in data["briefs"]:
            links = f" · links: {', '.join(b['authored_links'])}" if b["authored_links"] else ""
            print(f"- **{b['note']}**{links}\n  {b['description']}")
            if b["line"] and b["line"].lower() != b["description"].lower():
                print(f"  > {b['line']}")
            if b["excluded_stale"]:
                print(f"  ⊘ withheld — cites invalidated: {', '.join(b['excluded_stale'])}")
            for c in b.get("challenged", []):
                print(f"  ⚠ challenged {c['date']} ({c['scope']}) — {c['why'][:150]}")
        if not data["briefs"]:
            print("- (no matching notes — the map has nothing on this yet)")
    elif cmd == "path":
        if not data.get("path"):
            print(f"{data['from']}  ⇸  {data['to']}\n  {data['note']}")
        else:
            print(f"{data['hops']} hops:")
            for i, n in enumerate(data["path"]):
                print(f"  {'└─ ' if i else ''}{n}")
    elif cmd == "keystones":
        if data["ranked_by"] == "authored":
            print("ranked by AUTHORED links — inferred shown but not counted "
                  "(vocabulary overlap is not endorsement)")
        else:
            print("ranked by TOTAL inbound — inferred links included; "
                  "machine echo can inflate this")
        print(f"{'auth':>5} {'infer':>6} {'total':>6}  note")
        for r in data["keystones"]:
            print(f"{r['authored']:>5} {r['inferred']:>6} {r['inbound']:>6}  {r['note']}")
    elif cmd == "stale_refs":
        if not data["count"]:
            print("no live note points at an invalidated one — corrections have travelled")
        else:
            print(f"{data['count']} link(s) into invalidated notes "
                  f"({data['authored']} authored — those need a human; the rest clear on "
                  f"`memory-infer --write`)")
            for r in data["stale_refs"]:
                print(f"  {r['provenance']:<9} {r['note'][:38]:<38} -> {r['points_at']} ({r['state']})")
    elif cmd == "challenged":
        if not data["count"]:
            print("no open challenges — nothing in the map is marked doubted")
        else:
            print(f"{data['count']} open challenge(s) in {data['notes']} note(s) — the claim stays "
                  "in the file and stays readable; brief will not quote it as fact")
            for r in data["challenged"]:
                dead = f" [note {r['note_status']}]" if r["note_status"] else ""
                print(f"  {r['date']}  {r['note'][:36]:<36} [{r['scope']}]{dead} {r['why'][:88]}")
                if r["claim"]:
                    print(f"{'':>14}↳ {r['claim'][:96]}")
    elif cmd == "orphans":
        print(f"{data['count']} of {data['total']} notes have no links in or out")
        for o in data["orphans"]:
            print(f"  {o['realm'][:40]:<40} {o['note']}")
    elif cmd == "realms":
        print(f"{'realm':<46}{'notes':>6}{'intra':>7}{'cross':>7}{'dangl':>7}")
        for r in data["realms"]:
            print(f"{r['realm'][:44]:<46}{r['notes']:>6}{r['intra']:>7}{r['cross']:>7}{r['dangling']:>7}")
    elif cmd == "canvas":
        print(f"{data['canvas']}: {data['notes']} notes, {data['zones']} zones, "
              f"{data['cross_realm_edges']} cross-realm edges "
              f"({data['boundary_edges']} boundary, purple)")
    elif cmd == "spheregrid":
        why = {"cwd": "from this working directory", "flag": "as asked",
               "empty": "this project has no notes yet — showing the largest realm",
               "largest": "largest realm — this cwd has no vault realm"}[data["centre_from"]]
        print(f"{data['spheregrid']}: centred on {data['centre']} ({why})")
        print(f"  {data['notes']} notes in {data['galaxies']} galaxies "
              f"+ {data['minor']} minor, {data['rings']} rings deep")
        print(f"  {data['edges']} links ({data['ghost_edges']} inferred, drawn as ghosts), "
              f"{data['corridors']} corridors — open in a browser")
    elif cmd == "forcemap":
        print(f"{data['forcemap']}: {data['notes']} notes, {data['edges']} edges "
              f"({data['boundary_edges']} boundary), {data['identity_notes']} identity — "
              f"open in a browser")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--vault", default=str(Path.home() / ".claude/projects"))
    ap.add_argument("--json", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("neighbors"); p.add_argument("note"); p.add_argument("--hops", type=int, default=1)
    p = sub.add_parser("path"); p.add_argument("frm", metavar="from"); p.add_argument("to")
    p = sub.add_parser("keystones"); p.add_argument("-n", type=int, default=12)
    p.add_argument("--include-inferred", action="store_true",
                   help="rank by total inbound instead of authored-only (lets machine echo count)")
    p = sub.add_parser("brief"); p.add_argument("terms", nargs="+"); p.add_argument("-n", type=int, default=5)
    sub.add_parser("orphans")
    sub.add_parser("stale-refs")
    sub.add_parser("challenged")
    sub.add_parser("realms")
    p = sub.add_parser("canvas"); p.add_argument("--out", default=None)
    p = sub.add_parser("forcemap"); p.add_argument("--out", default=None)
    p = sub.add_parser("spheregrid"); p.add_argument("--out", default=None)
    p.add_argument("--center", default="auto",
                   help="realm at the origin: a realm slug/substring, or 'auto' (this cwd)")
    p.add_argument("--min-galaxy", type=int, default=4,
                   help="realms under this many notes render as minor, not their own galaxy")

    a = ap.parse_args()
    a.cmd = a.cmd.replace("-", "_")
    g = Graph(Path(a.vault).expanduser())
    data = {"neighbors": cmd_neighbors, "path": cmd_path, "keystones": cmd_keystones,
            "orphans": cmd_orphans, "realms": cmd_realms, "brief": cmd_brief,
            "canvas": cmd_canvas, "forcemap": cmd_forcemap, "spheregrid": cmd_spheregrid,
            "stale_refs": cmd_stale_refs, "challenged": cmd_challenged}[a.cmd](g, a)
    print(json.dumps(data, indent=2)) if a.json else render(a.cmd, data)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
graph.py — traverse the memory graph without reading every file.

An agent reading a note sees what it points AT (the links are in the text) but
cannot see what points AT IT without scanning the whole corpus. Backlinks are
the expensive direction, so that is what this precomputes.

Everything is derived from the markdown at call time — there is no index to
rebuild, nothing to keep in sync, and no daemon. At this corpus size a full
parse is a few milliseconds.

Links are reported with provenance: `authored` links are hand-written,
`inferred` ones come from the block infer-links.py maintains. Weight them
accordingly — an inferred link is a suggestion, not an assertion.

  graph.py neighbors <note> [--hops N]   what connects to this, both directions
  graph.py path <from> <to>              how two notes are related, if at all
  graph.py keystones [-n N]              most-linked-to notes
  graph.py orphans                       notes nothing reaches
  graph.py realms                        per-realm connectivity summary
  graph.py canvas [--out FILE]           realm zones as an Obsidian .canvas file
  graph.py forcemap [--out FILE]         force-directed map with realm forcefields (HTML)

Add --json to any subcommand for machine-readable output.
"""

from __future__ import annotations
import argparse, json, os, re, sys
from collections import defaultdict, deque
from pathlib import Path

BEGIN = "<!-- inferred-links:begin -->"
END = "<!-- inferred-links:end -->"
INVALID = re.compile(r"^\s*status:\s*(superseded|expired)\b", re.M | re.I)
WIKI = re.compile(r"\[\[([^\]|#]+)")
SCORED = re.compile(r"\[\[([^\]|#]+)\]\][^\n]*?—\s*(0\.\d+)")
MD = re.compile(r"\[[^\]]*\]\(([^)\s]+\.md)\)")


class Graph:
    def __init__(self, vault: Path):
        self.vault = vault
        self.realm: dict[str, str] = {}
        self.out: dict[str, list[tuple[str, str]]] = defaultdict(list)
        self.inn: dict[str, list[tuple[str, str]]] = defaultdict(list)
        self._load()

    def _load(self) -> None:
        # Nodes are keyed "<realm>/<stem>", NOT by basename. Thirteen realms each
        # hold a MEMORY.md; collapsing them into one node invents a 2-hop path
        # between every pair of realms through a file that does not exist.
        # Obsidian keeps them as distinct nodes too — only link *resolution* is
        # ambiguous there, which is what by_stem below models.
        paths = sorted(self.vault.glob("*/memory/*.md"))
        self.by_stem: dict[str, list[str]] = defaultdict(list)
        for p in paths:
            node = f"{p.parts[-3]}/{p.stem}"
            self.realm[node] = p.parts[-3]
            self.by_stem[p.stem].append(node)
        self.status: dict[str, str] = {}
        for p in paths:
            src = f"{p.parts[-3]}/{p.stem}"
            text = p.read_text(encoding="utf-8", errors="replace")
            sm = INVALID.search(text[:600])
            if sm:
                self.status[src] = sm.group(1).lower()
            authored, inferred = text, ""
            if BEGIN in text:
                authored, _, rest = text.partition(BEGIN)
                inferred, _, tail = rest.partition(END)
                authored += tail
            self.score = getattr(self, "score", {})
            for m in SCORED.finditer(inferred):
                self.score[(src, m.group(1).strip())] = float(m.group(2))
            for chunk, prov in ((authored, "authored"), (inferred, "inferred")):
                for raw in WIKI.findall(chunk):
                    self._edge(src, raw.strip(), prov)
                for raw in MD.findall(chunk):
                    self._edge(src, Path(raw).stem, prov)

    def _target(self, src: str, stem: str) -> str | None:
        """Resolve a link the way Obsidian does: a note in the linker's own realm
        wins; otherwise a unique vault-wide match. Ambiguous links resolve to
        nothing rather than to an arbitrary pick."""
        cands = self.by_stem.get(stem, [])
        same = [c for c in cands if self.realm[c] == self.realm.get(src)]
        if same:
            return same[0]
        return cands[0] if len(cands) == 1 else None

    def _edge(self, src: str, stem: str, prov: str) -> None:
        dst = self._target(src, stem)
        if dst is None:                       # ghost, or ambiguous across realms
            if (stem, prov) not in self.out[src]:
                self.out[src].append((stem, prov))
            return
        if dst == src:
            return
        if (dst, prov) not in self.out[src]:
            self.out[src].append((dst, prov))
        if (src, prov) not in self.inn[dst]:
            self.inn[dst].append((src, prov))

    def exists(self, name: str) -> bool:
        return name in self.realm

    def resolve(self, name: str) -> str | None:
        if name in self.realm:
            return name
        exact = self.by_stem.get(name, [])
        if len(exact) == 1:
            return exact[0]
        hits = exact or [n for n in self.realm if name.lower() in n.split("/")[-1].lower()]
        if len(hits) == 1:
            return hits[0]
        if hits:
            print(f"ambiguous: {name!r} matches {len(hits)}", file=sys.stderr)
            for h in sorted(hits)[:8]:
                print(f"  {h}", file=sys.stderr)
        return None

    def undirected(self, node: str) -> set[str]:
        return {d for d, _ in self.out[node] if d in self.realm} | {s for s, _ in self.inn[node]}


def cmd_neighbors(g: Graph, a) -> dict:
    node = g.resolve(a.note)
    if not node:
        print(f"no note matching {a.note!r}", file=sys.stderr)
        sys.exit(1)
    out = {"note": node, "realm": g.realm[node], "hops": {},
           "status": g.status.get(node)}
    seen, frontier = {node}, {node}
    for hop in range(1, a.hops + 1):
        nxt = set()
        for n in frontier:
            nxt |= g.undirected(n)
        nxt -= seen
        seen |= nxt
        out["hops"][hop] = sorted(nxt)
        frontier = nxt
    stem = node.split("/")[-1]
    def sc(a, b):
        return g.score.get((a, b.split("/")[-1]))
    out["outbound"] = [{"to": d, "provenance": p, "resolves": d in g.realm,
                        "score": sc(node, d)} for d, p in g.out[node]]
    out["inbound"] = [{"from": s, "provenance": p, "score": sc(s, node)} for s, p in g.inn[node]]
    return out


def cmd_path(g: Graph, a) -> dict:
    s, t = g.resolve(a.frm), g.resolve(a.to)
    if not s or not t:
        print("could not resolve both endpoints", file=sys.stderr)
        sys.exit(1)
    prev, q = {s: None}, deque([s])
    while q:
        cur = q.popleft()
        if cur == t:
            break
        for nb in sorted(g.undirected(cur)):
            if nb not in prev:
                prev[nb] = cur
                q.append(nb)
    if t not in prev:
        return {"from": s, "to": t, "path": None, "note": "no path — these are in disconnected components"}
    path, cur = [], t
    while cur is not None:
        path.append(cur)
        cur = prev[cur]
    return {"from": s, "to": t, "hops": len(path) - 1, "path": list(reversed(path))}


def cmd_keystones(g: Graph, a) -> dict:
    rows = []
    for n in g.realm:
        auth = sum(1 for _, p in g.inn[n] if p == "authored")
        infr = sum(1 for _, p in g.inn[n] if p == "inferred")
        if auth + infr:
            rows.append({"note": n.split("/")[-1], "realm": g.realm[n], "inbound": auth + infr,
                         "authored": auth, "inferred": infr})
    rows.sort(key=lambda r: (-r["inbound"], -r["authored"], r["note"]))
    return {"keystones": rows[: a.n]}


def cmd_orphans(g: Graph, a) -> dict:
    o = [{"note": n.split("/")[-1], "realm": g.realm[n]} for n in sorted(g.realm)
         if not g.out[n] and not g.inn[n]]
    return {"orphans": o, "count": len(o), "total": len(g.realm)}


def cmd_realms(g: Graph, a) -> dict:
    agg = defaultdict(lambda: {"notes": 0, "intra": 0, "cross": 0, "dangling": 0})
    for n, r in g.realm.items():
        agg[r]["notes"] += 1
        for d, _ in g.out[n]:
            if d not in g.realm:
                agg[r]["dangling"] += 1
            elif g.realm[d] == r:
                agg[r]["intra"] += 1
            else:
                agg[r]["cross"] += 1
    return {"realms": [{"realm": k, **v} for k, v in sorted(agg.items(), key=lambda kv: -kv[1]["notes"])]}


def cmd_brief(g: Graph, a) -> dict:
    """A §6-ready block: the map's most relevant notes for a spec being written.
    This is how loops read the map — at authoring time, pushed into the spec,
    never pulled at run time. Invalidated notes are excluded: history must not
    brief new work."""
    terms = [t.lower() for t in a.terms]
    scored = []
    for node, realm in g.realm.items():
        if node in g.status or node.split("/")[-1] == "MEMORY":
            continue
        path = g.vault / realm / "memory" / (node.split("/")[-1] + ".md")
        try:
            raw = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        desc = ""
        dm = re.search(r'^description:\s*["\']?(.+?)["\']?$', raw[:600], re.M)
        if dm:
            desc = dm.group(1)
        low = raw.lower()
        score = sum(3 * desc.lower().count(t) + low.count(t) for t in terms)
        if score == 0:
            continue
        best = ""
        for line in raw.splitlines():
            ll = line.lower()
            n = sum(ll.count(t) for t in terms)
            skip = line.startswith(("---", "description:")) or line.strip().startswith("[[")
            if n > 0 and len(line.strip()) > 20 and not skip:
                if not best or n > sum(best.lower().count(t) for t in terms):
                    best = line.strip().lstrip("-*# ").strip()
        neighbors = [d.split("/")[-1] for d, prov in g.out[node]
                     if prov == "authored" and d in g.realm][:3]
        scored.append({"note": node.split("/")[-1], "realm": realm, "score": score,
                       "description": desc, "line": best[:160], "authored_links": neighbors})
    scored.sort(key=lambda r: -r["score"])
    return {"query": " ".join(a.terms), "briefs": scored[: a.n]}


def cmd_canvas(g: Graph, a) -> dict:
    """Realm zones as a generated Obsidian Canvas — the layout the force-directed
    graph view cannot hold: one labeled group box per realm, personal realms on
    the left, work-- realms on the right, an empty corridor between the sides.
    Only cross-realm edges are drawn (the zone box already says "these belong
    together"); edges that cross the personal/work boundary are purple. A canvas
    is a snapshot, not live physics — regenerate after the vault changes."""
    NODE_W, NODE_H, PAD, COLS = 260, 50, 20, 3
    REALM_GAP, SIDE_GAP, COL_GAP = 80, 1800, 60

    def is_work(realm: str) -> bool:
        return realm.startswith("work--")

    def short(slug: str) -> str:
        s = slug.removeprefix("work--").removeprefix("-Users-mtgibbs-")
        return s or slug

    by_realm: dict[str, list[str]] = defaultdict(list)
    for node, realm in g.realm.items():
        if node.split("/")[-1] != "MEMORY":
            by_realm[realm].append(node)

    pairs: dict[frozenset, tuple[str, str, bool]] = {}
    for src in g.realm:
        if src.split("/")[-1] == "MEMORY":
            continue
        for dst, _ in g.out[src]:
            if dst not in g.realm or dst.split("/")[-1] == "MEMORY":
                continue
            if g.realm[dst] == g.realm[src]:
                continue
            pairs.setdefault(frozenset([src, dst]),
                             (src, dst, is_work(g.realm[src]) != is_work(g.realm[dst])))

    def box(n_notes: int) -> tuple[int, int]:
        rows = (n_notes + COLS - 1) // COLS
        return (COLS * NODE_W + (COLS + 1) * PAD,
                rows * (NODE_H + PAD) + PAD + 40)

    nodes: list[dict] = []
    placed: set[str] = set()
    for work in (False, True):
        realm_list = sorted((r for r in by_realm if is_work(r) == work),
                            key=lambda r: -len(by_realm[r]))
        base = 0 if not work else box(1)[0] * 2 + COL_GAP + SIDE_GAP
        col_x = [base, base + box(1)[0] + COL_GAP]
        col_y = [0, 0]
        for realm in realm_list:
            names = sorted(by_realm[realm])
            w, h = box(len(names))
            c = 0 if col_y[0] <= col_y[1] else 1
            gx, gy = col_x[c], col_y[c]
            col_y[c] += h + REALM_GAP
            nodes.append({"id": f"g-{realm}", "type": "group", "x": gx, "y": gy,
                          "width": w, "height": h, "label": short(realm),
                          **({"color": "1"} if work else {})})
            for i, node in enumerate(names):
                stem = node.split("/")[-1]
                nodes.append({"id": node, "type": "file",
                              "x": gx + PAD + (i % COLS) * (NODE_W + PAD),
                              "y": gy + 40 + PAD + (i // COLS) * (NODE_H + PAD),
                              "width": NODE_W, "height": NODE_H,
                              "file": f"{realm}/memory/{stem}.md"})
                placed.add(node)

    edges: list[dict] = []
    n_boundary = 0
    for i, (src, dst, boundary) in enumerate(pairs.values()):
        if src not in placed or dst not in placed:
            continue
        e: dict = {"id": f"e{i}", "fromNode": src, "toNode": dst}
        if boundary:
            n_boundary += 1
            e["color"] = "6"
            e["fromSide"] = "left" if is_work(g.realm[src]) else "right"
            e["toSide"] = "left" if is_work(g.realm[dst]) else "right"
        edges.append(e)

    out = Path(a.out).expanduser() if a.out else g.vault / "atlas.canvas"
    out.write_text(json.dumps({"nodes": nodes, "edges": edges}))
    return {"canvas": str(out),
            "notes": len(placed),
            "zones": sum(1 for n in nodes if n["type"] == "group"),
            "cross_realm_edges": len(edges),
            "boundary_edges": n_boundary}


TYPE_RE = re.compile(r"^\s*type:\s*(user|feedback)\b", re.M | re.I)


def cmd_forcemap(g: Graph, a) -> dict:
    """The force graph with forcefields: a self-contained HTML page (Canvas 2D,
    no dependencies, harness-console lineage). Real physics — springs, repulsion —
    but every node is also pulled toward its realm's anchor, so realms hold
    together as visible fields: personal wells left, work-- wells right, the
    corridor between them kept empty by design (boundary springs are weak on
    purpose). Data is embedded at generation time; regenerate when the vault
    moves. Clicking a node opens it in Obsidian via the obsidian:// URI."""
    def short(slug: str) -> str:
        s = slug.removeprefix("work--").removeprefix("-Users-mtgibbs-")
        return s or slug

    nodes, index = [], {}
    for node, realm in sorted(g.realm.items()):
        stem = node.split("/")[-1]
        if stem == "MEMORY":
            continue
        path = g.vault / realm / "memory" / (stem + ".md")
        try:
            head = path.read_text(encoding="utf-8", errors="replace")[:600]
        except OSError:
            head = ""
        index[node] = len(nodes)
        nodes.append({"stem": stem, "realm": realm, "short": short(realm),
                      "work": realm.startswith("work--"),
                      "gold": bool(TYPE_RE.search(head)),
                      "dead": node in g.status,
                      "deg": len(g.inn[node])})

    pairs: dict[frozenset, dict] = {}
    for src in index:
        for dst, _ in g.out[src]:
            if dst not in index or dst == src:
                continue
            same = g.realm[src] == g.realm[dst]
            boundary = nodes[index[src]]["work"] != nodes[index[dst]]["work"]
            pairs.setdefault(frozenset([src, dst]),
                             {"s": index[src], "t": index[dst],
                              "i": int(same), "b": int(boundary)})
    edges = list(pairs.values())

    data = json.dumps({"vault": g.vault.name, "nodes": nodes, "edges": edges}
                      ).replace("</", "<\\/")
    tpl_path = Path(__file__).resolve().parent.parent / "templates" / "forcemap.html"
    tpl = tpl_path.read_text(encoding="utf-8")
    assert tpl.count("__DATA__") == 1, f"placeholder missing in {tpl_path}"
    out = Path(a.out).expanduser() if a.out else g.vault / "atlas.html"
    out.write_text(tpl.replace("__DATA__", data))
    return {"forcemap": str(out), "notes": len(nodes), "edges": len(edges),
            "boundary_edges": sum(e["b"] for e in edges),
            "identity_notes": sum(1 for n in nodes if n["gold"])}


def render(cmd: str, data: dict) -> None:
    if cmd == "neighbors":
        flag = data.get("status")
        print(f"{data['note']}   [{data['realm']}]" + (f"   ⚠ {flag.upper()} — history, not current" if flag else ""))
        print(f"\n  outbound ({len(data['outbound'])}):")
        for e in data["outbound"]:
            flag = "" if e["resolves"] else "  ← GHOST, target does not exist"
            w = f" ({e['score']:.2f})" if e.get("score") else ""
            print(f"    {e['provenance']:<9}{w:<7} -> {e['to']}{flag}")
        print(f"\n  inbound ({len(data['inbound'])}):")
        for e in data["inbound"]:
            w = f" ({e['score']:.2f})" if e.get("score") else ""
            print(f"    {e['provenance']:<9}{w:<7} <- {e['from']}")
        for hop, names in data["hops"].items():
            if int(hop) > 1 and names:
                print(f"\n  {hop} hops away ({len(names)}): {', '.join(names[:12])}"
                      + (" …" if len(names) > 12 else ""))
    elif cmd == "brief":
        print(f"<!-- memory-brief · query: {data['query']} · point-in-time, verify before trusting -->")
        print("**Prior knowledge from the memory map:**\n")
        for b in data["briefs"]:
            links = f" · links: {', '.join(b['authored_links'])}" if b["authored_links"] else ""
            print(f"- **{b['note']}**{links}\n  {b['description']}")
            if b["line"] and b["line"].lower() != b["description"].lower():
                print(f"  > {b['line']}")
        if not data["briefs"]:
            print("- (no matching notes — the map has nothing on this yet)")
    elif cmd == "path":
        if not data.get("path"):
            print(f"{data['from']}  ⇸  {data['to']}\n  {data['note']}")
        else:
            print(f"{data['hops']} hops:")
            for i, n in enumerate(data["path"]):
                print(f"  {'└─ ' if i else ''}{n}")
    elif cmd == "keystones":
        print(f"{'inbound':>8} {'auth':>5} {'infer':>6}  note")
        for r in data["keystones"]:
            print(f"{r['inbound']:>8} {r['authored']:>5} {r['inferred']:>6}  {r['note']}")
    elif cmd == "orphans":
        print(f"{data['count']} of {data['total']} notes have no links in or out")
        for o in data["orphans"]:
            print(f"  {o['realm'][:40]:<40} {o['note']}")
    elif cmd == "realms":
        print(f"{'realm':<46}{'notes':>6}{'intra':>7}{'cross':>7}{'dangl':>7}")
        for r in data["realms"]:
            print(f"{r['realm'][:44]:<46}{r['notes']:>6}{r['intra']:>7}{r['cross']:>7}{r['dangling']:>7}")
    elif cmd == "canvas":
        print(f"{data['canvas']}: {data['notes']} notes, {data['zones']} zones, "
              f"{data['cross_realm_edges']} cross-realm edges "
              f"({data['boundary_edges']} boundary, purple)")
    elif cmd == "forcemap":
        print(f"{data['forcemap']}: {data['notes']} notes, {data['edges']} edges "
              f"({data['boundary_edges']} boundary), {data['identity_notes']} identity — "
              f"open in a browser")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--vault", default=str(Path.home() / ".claude/projects"))
    ap.add_argument("--json", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("neighbors"); p.add_argument("note"); p.add_argument("--hops", type=int, default=1)
    p = sub.add_parser("path"); p.add_argument("frm", metavar="from"); p.add_argument("to")
    p = sub.add_parser("keystones"); p.add_argument("-n", type=int, default=12)
    p = sub.add_parser("brief"); p.add_argument("terms", nargs="+"); p.add_argument("-n", type=int, default=5)
    sub.add_parser("orphans")
    sub.add_parser("realms")
    p = sub.add_parser("canvas"); p.add_argument("--out", default=None)
    p = sub.add_parser("forcemap"); p.add_argument("--out", default=None)

    a = ap.parse_args()
    g = Graph(Path(a.vault).expanduser())
    data = {"neighbors": cmd_neighbors, "path": cmd_path, "keystones": cmd_keystones,
            "orphans": cmd_orphans, "realms": cmd_realms, "brief": cmd_brief,
            "canvas": cmd_canvas, "forcemap": cmd_forcemap}[a.cmd](g, a)
    print(json.dumps(data, indent=2)) if a.json else render(a.cmd, data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
